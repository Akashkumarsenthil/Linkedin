+/* ── S.I.M.P.S.O.N. (Premium Sky Theme) ── */
+.simson-card { border-radius: var(--r); padding: 12px; display: flex; align-items: center; gap: 12px; margin-bottom: 12px; position: relative; overflow: hidden; min-height: 88px; }
+.ln-blue-sky {
+  background: linear-gradient(180deg, var(--accent, #0a66c2) 0%, #004d99 100%) !important;
+  color: #fff !important; border: 1px solid rgba(255,255,255,0.3) !important;
+  box-shadow: 0 4px 12px rgba(10, 102, 194, 0.2) !important;
+}
+.ln-blue-sky-gradient { background: linear-gradient(90deg, var(--accent, #0a66c2), #5b9bd5) !important; }
